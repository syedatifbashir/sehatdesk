# ── Database ──
DATABASE_URL="postgresql://hms:hms@localhost:5432/hms?schema=public"
# ── Auth ──
JWT_SECRET="change-me-to-64-random-chars"
JWT_REFRESH_SECRET="change-me-to-another-64-random-chars"
# ── App ──
APP_URL="http://localhost:3000"
# ── WhatsApp Cloud API (per hospital, also stored encrypted in DB) ──
WA_VERIFY_TOKEN="change-me-verify-token"
WA_APP_SECRET="change-me-app-secret"
# ── n8n backend (WhatsApp bot flows run here) ──
# Incoming Meta webhooks are forwarded here when set; leave empty to use the built-in fallback bot.
N8N_WHATSAPP_WEBHOOK_URL=""
N8N_API_KEY=""
# ── AI (visit summaries + AI doctor) ──
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
